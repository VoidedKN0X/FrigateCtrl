<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up or copied to a new phone: the server address, encrypted login, pinned
    certificate, PIN hash and settings stay on this device. (allowBackup="false" alone doesn't stop
    device-to-device transfers on Android 12 and later.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
